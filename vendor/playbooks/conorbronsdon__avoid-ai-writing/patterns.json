  "categories": {
    "ai-citation-markup": {
      "severity": "critical",
      "weight": 15,
      "label": "Chatbot citation markup leak",
      "groups": [
        "AI_CITATION_MARKUP"
      ],
      "patterns": [
        {
          "source": "\\bcite(?:turn|news|search|navigation)\\d+(?:search|turn|news|navigation)\\d+",
          "flags": "gi"
        },
        {
          "source": "contentReference\\s*\\[oaicite:[^\\]]+\\]\\s*\\{[^}]*\\}",
          "flags": "gi"
        },
        {
          "source": "\\boai_citation\\b",
          "flags": "gi"
        },
        {
          "source": "\\[attached_file:\\d+\\]",
          "flags": "gi"
        },
        {
          "source": "\\bgrok_card\\b",
          "flags": "gi"
        }
      ]
    },
    "ai-placeholder": {
      "severity": "critical",
      "weight": 10,
      "label": "Unfilled placeholder",
      "groups": [
        "AI_PLACEHOLDERS"
      ],
      "patterns": [
        {
          "source": "\\[(?:Your|Insert|Add|Enter|Describe|Specify|Choose|Pick)[^\\]\\n]{1,80}\\]",
          "flags": "gi"
        },
        {
          "source": "\\[(?:Recipient|Sender|Topic|Subject|Salutation|Closing|Position|Department|Project Name|Company Name|Date)(?:\\s+[^\\]\\n]{0,60})?\\]",
          "flags": "gi"
        },
        {
          "source": "\\[(?:INSERT|FILL\\s+IN|ADD|TODO|TBD|PLACEHOLDER)[^\\]\\n]{0,80}\\]",
          "flags": "g"
        },
        {
          "source": "\\b(?:19|20)\\d{2}-XX-XX\\b",
          "flags": "g"
        },
        {
          "source": "\\bXX\\/XX\\/(?:19|20)\\d{2}\\b",
          "flags": "g"
        },
        {
          "source": "<!--\\s*(?:add|fill\\s+in|insert|todo|placeholder)[^>]{0,120}-->",
          "flags": "gi"
        }
      ]
    },
    "ai-utm-source": {
      "severity": "critical",
      "weight": 12,
      "label": "AI-tool URL parameter",
      "groups": [
        "AI_UTM_SOURCE"
      ],
      "patterns": [
        {
          "source": "[?&]utm_source=(?:chatgpt|openai|copilot|claude|grok|gemini|perplexity)(?:\\.com|\\.ai)?\\b",
          "flags": "gi"
        },
        {
          "source": "[?&]referrer=(?:chatgpt|copilot|grok|claude|gemini|perplexity)\\.(?:com|ai)\\b",
          "flags": "gi"
        }
      ]
    },
