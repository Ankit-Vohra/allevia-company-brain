{
  "name": "allevia-site",
  "version": "0.1.0",
  "private": true,
  "description": "Allevia marketing site: home and /pricing. Static Vite build; prices and the roster are generated from shared/plans.ts and shared/roster.ts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:links": "node scripts/check-links.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check": "npm run build && npm run check:links && npm run check:placeholders",
    "check:a11y": "node scripts/a11y.mjs",
    "images": "node scripts/images.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:v6": "node scripts/shots-v6.mjs",
    "lab": "node scripts/lab.mjs",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/three": "^0.186.0",
    "axe-core": "^4.10.2",
    "motion": "^14.3.0",
    "playwright": "^1.64.1",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
