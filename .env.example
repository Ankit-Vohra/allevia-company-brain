# Every environment name Allevia reads. Real values live in ~/.config/allevia/allevia.env (KEY=VALUE, mode 600),
# never in this repo; process env overrides that file. Leave a name unset to get the default noted beside it.

# --- config file ---
ALLEVIA_ENV_FILE=             # path of the KEY=VALUE file to read (default ~/.config/allevia/allevia.env)

# --- graph ---
ALLEVIA_FALKORDB_URL=         # default redis://127.0.0.1:6390 (never 6379: that is another Redis)
ALLEVIA_META_GRAPH=           # tenant registry graph (default allevia_meta; tests point it at a throwaway graph)

# --- models ---
ALLEVIA_MODEL=                # chat model (default sonnet)
ALLEVIA_EXTRACT_MODEL=        # bulk extraction model (default haiku)
ALLEVIA_MODELS_DIR=           # local embedding models (default <repo>/models)
ANTHROPIC_API_KEY=            # not used: the Agent SDK runs on the founder's subscription and strips this from its env

# --- paths ---
ALLEVIA_DATA_DIR=             # snapshots, extraction cache, crawls (default <repo>/data)
ALLEVIA_BRAIN_PATH=           # the founder's vault (default ~/aamdani-brain)

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# --- AVS Atelier Instagram ---
AVS_IG_LOGIN_ACCESS_TOKEN=
AVS_IG_USER_ID=

# --- ops box (aamdani-ops MCP over SSH) ---
ALLEVIA_OPS_SSH_VIA=          # ssh alias used to reach the box, EC2 Instance Connect (default aamdani-box)
ALLEVIA_OPS_SSH_HOST=         # only with ALLEVIA_OPS_SSH_VIA=none: the box address
ALLEVIA_OPS_SSH_USER=         # default ankit
ALLEVIA_OPS_SSH_KEY=          # only with ALLEVIA_OPS_SSH_VIA=none: path to the ssh key
ALLEVIA_OPS_REMOTE_DIR=       # default /home/ankit/aamdani-social-automation

# --- actions, server ---
ALLEVIA_ACTION_REPO=          # repo approved actions file issues in (default Ankit-Vohra/allevia)
ALLEVIA_PUBLIC_MODE=          # 1/true hides private data for a public demo (default off)
PORT=                         # API server port (default 8787)
ALLEVIA_WEB_URL=              # the web app's address, for links from Discord (default http://127.0.0.1:<PORT>)

# --- tests ---
ALLEVIA_LIVE_LLM=             # 1 runs the live extraction test (costs plan usage)
